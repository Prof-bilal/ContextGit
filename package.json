{
  "name": "contextgit-tooling",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "website:dev": "npm run dev --prefix website",
    "website:build": "npm run build --prefix website",
    "desktop:build": "bun run --cwd desktop build",
    "desktop:tauri:dev": "bun run --cwd desktop tauri:dev",
    "desktop:tauri:build": "bun run --cwd desktop tauri:build",
    "desktop:tauri:check": "bun run --cwd desktop tauri:check",
    "check:structure": "node scripts/check-structure.mjs",
    "check:release": "node scripts/check-release-metadata.mjs",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
