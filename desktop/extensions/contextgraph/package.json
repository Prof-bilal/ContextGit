{
  "name": "contextgraph",
  "displayName": "ContextGit Graph",
  "description": "The ContextGit conversation history as a graph, inside the editor.",
  "version": "0.1.0",
  "publisher": "contextgit",
  "license": "Apache-2.0",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["SCM Providers", "Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "contextgitGraph.show",
        "title": "ContextGit: Show context graph"
      },
      {
        "command": "contextgitGraph.refresh",
        "title": "ContextGit: Refresh context graph"
      }
    ],
    "configuration": {
      "title": "ContextGit Graph",
      "properties": {
        "contextgitGraph.backendUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8756",
          "description": "ContextGit backend base URL (written automatically by the app)."
        }
      }
    }
  }
}
