{
  "name": "contextgit-copilot",
  "displayName": "ContextGit Copilot",
  "description": "Copilot-style inline completions from your own ContextGit provider.",
  "version": "0.1.0",
  "publisher": "contextgit",
  "license": "Apache-2.0",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Programming Languages", "Machine Learning"],
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "contextgitCopilot.toggle",
        "title": "ContextGit: Toggle inline completions"
      },
      {
        "command": "contextgitCopilot.completeNow",
        "title": "ContextGit: Complete now"
      }
    ],
    "configuration": {
      "title": "ContextGit Copilot",
      "properties": {
        "contextgitCopilot.backendUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8756",
          "description": "ContextGit backend base URL (written automatically by the app)."
        },
        "contextgitCopilot.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show inline completions."
        },
        "contextgitCopilot.providerId": {
          "type": "string",
          "default": "",
          "description": "Editor provider id. Empty uses the first connected one."
        },
        "contextgitCopilot.model": {
          "type": "string",
          "default": "",
          "description": "Model override (empty uses the provider default)."
        },
        "contextgitCopilot.maxTokens": { "type": "number", "default": 128 },
        "contextgitCopilot.debounceMs": { "type": "number", "default": 300 },
        "contextgitCopilot.languages": {
          "type": "array",
          "items": { "type": "string" },
          "default": [
            "typescript",
            "typescriptreact",
            "javascript",
            "javascriptreact",
            "python",
            "java",
            "kotlin"
          ],
          "description": "Language ids that get inline completions."
        }
      }
    }
  }
}
