{
  "name": "contextgit-desktop",
  "private": true,
  "version": "0.2.0-beta.3",
  "license": "Apache-2.0",
  "author": "Prof-bilal <Prof-bilal@users.noreply.github.com>",
  "homepage": "https://github.com/Prof-bilal/ContextGit",
  "desktopName": "dev.contextgit.desktop",
  "description": "ContextGit desktop workbench — version control for LLM conversations",
  "scripts": {
    "dev": "bun run tauri:dev",
    "dev:mock": "vite",
    "tauri:dev": "tauri dev --config src-tauri/tauri.conf.json",
    "tauri:build": "tauri build --config src-tauri/tauri.conf.json",
    "tauri:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "typecheck": "tsc --noEmit",
    "test:workspace": "node scripts/test-workspace-performance.mjs",
    "test:layout": "node --test scripts/test-native-layout.mjs",
    "test:editor": "node --test scripts/test-native-layout.mjs scripts/test-editor-extension.mjs scripts/test-backend-bridge.mjs",
    "test:editor-runtime": "node scripts/test-editor-runtime.mjs",
    "test:browser": "node --test scripts/test-browser-address.mjs",
    "build:renderer": "vite build",
    "build": "bun run typecheck && bun run build:renderer && bun run build:backend",
    "build:backend": "bun scripts/build-backend.mjs",
    "fetch:editor": "node scripts/fetch-editor.mjs",
    "checksums": "bun scripts/checksums.mjs",
    "collect:tauri": "bun scripts/collect-tauri-release.mjs",
    "check:tauri-artifacts": "node scripts/check-tauri-artifacts.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.12.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  },
  "allowScripts": {}
}
